# Copy to .env (or run `npm run setup`, which also fills in the secrets).

# Where the server listens. Put a TLS-terminating proxy or tunnel in front of it.
HOST=127.0.0.1
PORT=5190

# The public address of the app, without a trailing slash.
PUBLIC_URL=https://quant.example.com

# Filled in by `npm run setup` / `npm run set-password`.
APP_PASSWORD_HASH=
SESSION_SECRET=
VOICE_WORKER_TOKEN=

# --- Claude ---
# With an API key the server calls the Anthropic API. Without one it runs the Claude Code CLI
# in headless mode, using the Claude login of the account the server runs under.
# ANTHROPIC_API_KEY=
# CLAUDE_CLI=claude
# Model and effort per kind of request: writing lessons, checking an answer, one-line jobs.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=
# CLAUDE_CHECK_MODEL=claude-sonnet-5-5
# CLAUDE_CHECK_EFFORT=low
# CLAUDE_QUICK_MODEL=claude-haiku-5-5
# CLAUDE_QUICK_EFFORT=low

# --- Natural voice (optional) ---
# Command that starts the GPU voice worker, and one that releases the GPU. See colab/README.md.
# On Windows with the Colab CLI inside WSL:
# VOICE_LAUNCH_CMD=wsl.exe -d Ubuntu -- bash /mnt/d/quant-prep-room/colab/launch.sh
# VOICE_STOP_CMD=wsl.exe -d Ubuntu -- bash /mnt/d/quant-prep-room/colab/stop.sh
# VOICE_GPU=T4
# VOICE_IDLE_MINUTES=15
# VOICE_MAX_MINUTES=180
